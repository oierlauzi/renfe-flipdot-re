# Never let git "fix" line endings or try to merge the ground truth.
original/firmware.bin   binary
*.bin                   binary
*.rom                   binary

# Photos and datasheets
*.jpg                   binary
*.jpeg                  binary
*.png                   binary
*.pdf                   binary

# Text files use LF everywhere
*.md                    text eol=lf
*.py                    text eol=lf
*.asm                   text eol=lf
*.inc                   text eol=lf
*.csv                   text eol=lf
Makefile                text eol=lf
