# Build artefacts
/build/
*.p
*.lst
*.lst.new

# ESP-IDF. sdkconfig is generated from sdkconfig.defaults on first build and
# then records whatever menuconfig was used for since, so it is a local file;
# sdkconfig.defaults is the one that is committed. managed_components/ is
# fetched from Espressif's registry.
/controller/build/
/controller/test/build/
/controller/managed_components/
/controller/sdkconfig
/controller/sdkconfig.old
/controller/dependencies.lock

# Ghidra projects are binary blobs and cannot be reviewed or merged.
# The analysis lives in ghidra/symbols.csv instead - see ghidra/README.md.
*.rep/
*.gpr
*.gzf
ghidra_*/
.ghidra/

# Generated exports
/font.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Logic analyser / scope captures can be huge; keep them out unless
# deliberately added with `git add -f` after downsampling.
*.sr
*.logicdata
*.wfm
*.csv.gz
